{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "uri", "kind", "sha256", "width", "height", "source_url"],
  "properties": {
    "asset_id": {
      "$ref": "common.schema.json#/$defs/resourceId"
    },
    "uri": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "source_url": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "source_asset_id": {
      "$ref": "common.schema.json#/$defs/resourceId"
    },
    "format": {
      "type": "string",
      "enum": ["webp", "jpeg", "png"]
    }
  }
}
