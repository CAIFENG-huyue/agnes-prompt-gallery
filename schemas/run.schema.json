{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "experiment_version_id",
    "arm_id",
    "case_id",
    "prompt_version_id",
    "rep",
    "blind_id",
    "result_asset_ids"
  ],
  "properties": {
    "run_id": {
      "$ref": "common.schema.json#/$defs/resourceId"
    },
    "experiment_version_id": {
      "$ref": "common.schema.json#/$defs/experimentVersionId"
    },
    "arm_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/caseId"
    },
    "prompt_version_id": {
      "$ref": "common.schema.json#/$defs/promptVersionId"
    },
    "rep": {
      "type": "integer",
      "minimum": 1
    },
    "blind_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "result_asset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/resourceId"
      }
    },
    "seed": {
      "type": "integer"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    }
  }
}
