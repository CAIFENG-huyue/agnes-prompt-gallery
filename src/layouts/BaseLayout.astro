---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "以案例为主：本站生成图、判定、失败门槛与开源项目原图对照。"
} = Astro.props;
const pageTitle = title === "Agnes Bench" ? title : `${title} · Agnes Bench`;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = pathname === "/";
const sections = [
  { href: "/", label: "案例", match: (path: string) => path === "/" || path.startsWith("/cases") },
  { href: "/patterns/", label: "规律", match: (path: string) => path.startsWith("/patterns") },
  { href: "/conclusions/", label: "结论", match: (path: string) => path.startsWith("/conclusions") }
];
const current = sections.find((item) => item.match(pathname));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f5ef" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "is-home": isHome, "is-case": pathname.startsWith("/cases") }}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>

    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href="/" aria-label="Agnes Bench 首页">
          <span class="brand__mark" aria-hidden="true">AB</span>
          <span class="brand__name">Agnes Bench</span>
        </a>

        <div class="topbar__center">
          {!isHome && <span class="topbar__page">{current?.label ?? "案例"}</span>}
        </div>

        <nav class="desktop-nav" aria-label="主导航">
          {sections.map((item) => (
            <a href={item.href} aria-current={current?.href === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>

        <div class="topbar__actions">
          <a class="icon-button" href="/#case-filter" aria-label="筛选案例">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content" class="page-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Agnes Bench</span>
        <span>案例优先 · 判定与失败门槛来自案例数据</span>
      </div>
    </footer>

    <nav class="tabbar" aria-label="移动端导航">
      {sections.map((item) => (
        <a
          class:list={["tabbar__item", { "is-active": current?.href === item.href }]}
          href={item.href}
          aria-current={current?.href === item.href ? "page" : undefined}
        >
          <span class="tabbar__icon" aria-hidden="true">
            {item.href === "/" && (
              <svg viewBox="0 0 24 24"><path d="M4 5h7v7H4zM13 5h7v7h-7zM4 14h7v5H4zM13 14h7v5h-7z"></path></svg>
            )}
            {item.href === "/patterns/" && (
              <svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19V8"></path></svg>
            )}
            {item.href === "/conclusions/" && (
              <svg viewBox="0 0 24 24"><path d="M5 4h9l5 5v11H5zM14 4v5h5M8 13h8M8 17h6"></path></svg>
            )}
          </span>
          <span class="tabbar__label">{item.label}</span>
        </a>
      ))}
    </nav>
  </body>
</html>
