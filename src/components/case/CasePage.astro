---
import CaseHero from "./CaseHero.astro";
import DecisionCard from "./DecisionCard.astro";
import EvidenceDrawer from "./EvidenceDrawer.astro";
import { anchorId } from "./model.js";
import type { CasePageModel } from "./model.js";

interface Props {
  page: CasePageModel;
}

const { page } = Astro.props;
const { caseData, guide, decisions, prompts, classification, fingerprint } = page;
---

<article class="case-page" data-case-id={caseData.case_id} data-case-page data-active-panel="decisions">
  <CaseHero page={page} />

  <nav class="case-tabs" aria-label="案例内容切换">
    <button type="button" class="case-tabs__item is-active" data-case-tab="decisions" aria-selected="true">决策卡</button>
    <button type="button" class="case-tabs__item" data-case-tab="evidence" aria-selected="false">证据</button>
    <button type="button" class="case-tabs__item" data-case-tab="prompts" aria-selected="false">提示词</button>
  </nav>

  <section class="case-section" id="decisions" data-section="decisions" data-case-panel="decisions" aria-labelledby="decisions-title">
    <header class="case-section__heading">
      <p>01 / 决策卡</p>
      <div>
        <h2 id="decisions-title">每个约束，都要能说清代价</h2>
        <span>决策 → 控制了什么 → 换掉会怎样；推断与实测分卡展示。</span>
      </div>
    </header>
    <div class="decision-list">
      {decisions.map((item) => <DecisionCard item={item} />)}
    </div>
  </section>

  <section class="case-section" id="challenges" data-section="challenges" data-case-panel="decisions" aria-labelledby="challenges-title">
    <header class="case-section__heading">
      <p>02 / 共性难点</p>
      <div>
        <h2 id="challenges-title">整体像，不等于逐项对</h2>
        <span>这些检查项来自本案例的结构指纹与提示词。</span>
      </div>
    </header>
    <ol class="challenge-list" data-self-explanation="common-challenges">
      {guide.common_challenges.map((challenge, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p>{challenge}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="case-section" id="transfer" data-section="transfer" data-case-panel="decisions" aria-labelledby="transfer-title">
    <div class="transfer-card">
      <p>03 / 一条可迁移写法</p>
      <h2 id="transfer-title">换掉题材时，保留结构契约</h2>
      <p data-self-explanation="transferable-rule">{guide.transferable_rule}</p>
    </div>
  </section>

  <section class="case-section" id="evidence" data-section="evidence" data-case-panel="evidence" aria-labelledby="evidence-title">
    <header class="case-section__heading">
      <p>04 / 证据</p>
      <div>
        <h2 id="evidence-title">从结论回到短证据、Run 与图片</h2>
        <span>默认折叠。实验卡中的数字可继续下钻到当前评分修订和具体结果图。</span>
      </div>
    </header>
    <div class="evidence-list">
      {decisions.map((item) => <EvidenceDrawer item={item} caseTitle={caseData.title} />)}
    </div>
  </section>

  <section class="case-section case-sources" id="sources" data-section="sources" data-case-panel="evidence" aria-labelledby="sources-title">
    <header class="case-section__heading">
      <p>05 / 版本与来源</p>
      <div>
        <h2 id="sources-title">知道它从哪里来</h2>
        <span>分类、指纹、指南与提示词分别保留版本，不用来源原文替代判断。</span>
      </div>
    </header>

    <div class="source-grid">
      <section class="source-card">
        <h3>案例来源</h3>
        <p>{caseData.source.source_label}</p>
        <a href={caseData.source.source_url} rel="noreferrer">打开来源页面</a>
      </section>
      <section class="source-card">
        <h3>分类依据</h3>
        <p>{classification.rationale}</p>
        <code>{classification.classifier_version}</code>
      </section>
      <section class="source-card">
        <h3>指南版本</h3>
        <p><code>{guide.guide_id}</code></p>
        <code>{guide.guide_version}</code>
      </section>
    </div>

    <details class="fingerprint-source" id="fingerprint-evidence" data-fingerprint-evidence>
      <summary>查看三个关键指纹的完整结构依据</summary>
      <div>
        <dl>
          <div><dt>主体数量</dt><dd>{fingerprint.subject_count}</dd></div>
          <div><dt>画幅</dt><dd>{fingerprint.ratio}</dd></div>
          <div><dt>版式</dt><dd>{fingerprint.layout}</dd></div>
          <div><dt>输入方式</dt><dd>{fingerprint.input_mode}</dd></div>
        </dl>
        <p class="fingerprint-source__excerpt">{fingerprint.evidence_excerpt}</p>
        <div class="fingerprint-source__columns">
          <section>
            <h3>文字槽位</h3>
            {fingerprint.text_slots.length > 0 ? (
              <ul>
                {fingerprint.text_slots.map((slot) => (
                  <li><code>{slot.slot_id}</code> · {slot.role} · {slot.required ? "必填" : "可选"}</li>
                ))}
              </ul>
            ) : <p>无独立文字槽位。</p>}
          </section>
          <section>
            <h3>结构关系</h3>
            {fingerprint.relations.length > 0 ? (
              <ul>
                {fingerprint.relations.map((relation) => (
                  <li><code>{relation.source_slot}</code> → {relation.relation} → <code>{relation.target_slot}</code></li>
                ))}
              </ul>
            ) : <p>无额外关系记录。</p>}
          </section>
        </div>
        <code>{fingerprint.fingerprint_version}</code>
      </div>
    </details>
  </section>

  <details class="prompt-archive" data-prompt-archive>
    <summary>
      <span>完整提示词原文</span>
      <span>{prompts.length} 个版本 · 默认折叠</span>
    </summary>
    <div class="prompt-archive__body">
      <div class="prompt-archive__bar">
        <div>
          <p class="eyebrow">Prompts</p>
          <h3 id="prompts-title">完整提示词原文</h3>
        </div>
        <button type="button" class="prompt-archive__close" data-prompt-close>关闭</button>
      </div>
      <p class="prompt-archive__hint">仅作来源证据，各版本默认折叠。</p>
      <div class="prompt-list">
        {prompts.map((prompt) => (
          <details
            id={`prompt-${anchorId(prompt.prompt_version_id)}`}
            data-prompt-version={prompt.prompt_version_id}
          >
            <summary>
              <span>版本 {prompt.version_no} · <code>{prompt.prompt_version_id}</code></span>
              <span>{prompt.change_note}</span>
            </summary>
            <div class="prompt-source">
              <pre>{prompt.text}</pre>
              <p>SHA-256 <code>{prompt.content_sha256}</code></p>
              {prompt.parent_version_id && <p>父版本 <code>{prompt.parent_version_id}</code></p>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </details>

  <button type="button" class="case-prompt-cta" data-prompt-open>
    <span>查看完整提示词</span>
    <span class="case-prompt-cta__count">{prompts.length}</span>
  </button>

  <div class="sheet-backdrop" data-prompt-backdrop hidden></div>
</article>

<script>
  const page = document.querySelector<HTMLElement>("[data-case-page]");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-case-tab]")];
  const archive = document.querySelector<HTMLDetailsElement>("[data-prompt-archive]");
  const backdrop = document.querySelector<HTMLElement>("[data-prompt-backdrop]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-prompt-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-prompt-close]");
  const mobile = window.matchMedia("(max-width: 63.99rem)");

  function setPanel(panel: string): void {
    if (!page) return;
    page.dataset.activePanel = panel;
    for (const tab of tabs) {
      if (tab.dataset.caseTab === "prompts") continue;
      const active = tab.dataset.caseTab === panel;
      tab.classList.toggle("is-active", active);
      tab.setAttribute("aria-selected", String(active));
    }
  }

  function openPrompts(): void {
    if (!archive) return;
    archive.open = true;
    if (mobile.matches) {
      archive.classList.add("is-sheet");
      document.body.classList.add("prompt-open");
      if (backdrop) backdrop.hidden = false;
      closeButton?.focus();
    }
  }

  function closePrompts(): void {
    if (!archive) return;
    archive.classList.remove("is-sheet");
    archive.open = false;
    document.body.classList.remove("prompt-open");
    if (backdrop) backdrop.hidden = true;
    openButton?.focus();
    if (page) setPanel(page.dataset.activePanel ?? "decisions");
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      const target = tab.dataset.caseTab ?? "decisions";
      if (target === "prompts") {
        openPrompts();
        return;
      }
      setPanel(target);
    });
  }

  openButton?.addEventListener("click", openPrompts);
  closeButton?.addEventListener("click", closePrompts);
  backdrop?.addEventListener("click", closePrompts);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && archive?.classList.contains("is-sheet")) closePrompts();
  });
</script>

<style>
  .case-page {
    min-width: 0;
    padding-top: var(--space-3);
  }

  .case-section {
    min-width: 0;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .case-section__heading {
    display: grid;
    gap: 0.35rem;
    margin-bottom: var(--space-3);
  }

  .case-section__heading > p,
  .transfer-card > p:first-child {
    margin: 0;
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .case-section__heading h2,
  .transfer-card h2 {
    margin-bottom: 0.25rem;
    font-size: var(--text-lg);
  }

  .case-section__heading div > span {
    display: block;
    max-width: 44rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .decision-list,
  .evidence-list {
    display: grid;
    min-width: 0;
    gap: var(--space-3);
  }

  .challenge-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .challenge-list li {
    display: grid;
    min-width: 0;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .challenge-list li > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .challenge-list p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .transfer-card {
    padding: var(--space-4);
    border-radius: var(--radius-large);
    background: var(--color-forest-deep);
    color: #eef3ed;
  }

  .transfer-card > p:first-child {
    margin-bottom: var(--space-2);
    color: var(--color-lime);
  }

  .transfer-card h2 {
    color: white;
    font-size: var(--text-base);
  }

  .transfer-card > p:last-child {
    max-width: 58rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .case-sources {
    padding-bottom: var(--space-2);
  }

  .source-grid {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .source-card {
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .source-card h3,
  .fingerprint-source h3,
  .prompt-archive h3 {
    margin-bottom: 0.3rem;
    font-size: var(--text-sm);
  }

  .source-card p {
    margin-bottom: 0.4rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .source-card a {
    color: var(--color-forest);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .fingerprint-source,
  .prompt-list details {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--topbar-height) + 1rem);
  }

  .fingerprint-source > summary,
  .prompt-list summary {
    padding: var(--space-3);
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .fingerprint-source > div {
    min-width: 0;
    padding: 0 var(--space-3) var(--space-3);
  }

  .fingerprint-source dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .fingerprint-source dl > div {
    min-width: 0;
    padding: 0.5rem;
    border-radius: var(--radius-small);
    background: var(--color-surface-muted);
  }

  .fingerprint-source dt {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }

  .fingerprint-source dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .fingerprint-source__excerpt {
    margin-block: var(--space-3);
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    color: var(--color-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .fingerprint-source__columns {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .fingerprint-source__columns ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .fingerprint-source__columns li {
    margin-bottom: 0.25rem;
    overflow-wrap: anywhere;
  }

  .fingerprint-source__columns p {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .prompt-archive {
    min-width: 0;
    margin-top: var(--space-5);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--topbar-height) + 1rem);
  }

  .prompt-archive > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem var(--space-3);
    padding: var(--space-4);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .prompt-archive > summary > span:last-child {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .prompt-archive__body {
    min-width: 0;
    padding: 0 var(--space-4) var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .prompt-archive__bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
  }

  .prompt-archive__bar h3 {
    margin-bottom: 0;
    font-size: var(--text-base);
  }

  .prompt-archive__close {
    display: none;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-forest-deep);
    font-size: var(--text-xs);
    font-weight: 650;
    cursor: pointer;
  }

  .prompt-archive__hint {
    margin-block: var(--space-2) var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .prompt-list {
    display: grid;
    gap: var(--space-2);
  }

  .prompt-list summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem var(--space-3);
  }

  .prompt-list summary > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .prompt-list summary > span:last-child {
    color: var(--color-muted);
    font-size: 0.6875rem;
    font-weight: 500;
  }

  .prompt-source {
    min-width: 0;
    padding: 0 var(--space-3) var(--space-3);
  }

  .prompt-source pre {
    max-width: 100%;
    margin: 0;
    padding: var(--space-3);
    overflow: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    background: #f4f5f1;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .prompt-source p {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: 0.6875rem;
    overflow-wrap: anywhere;
  }

  /* Mobile tabs */
  .case-tabs {
    position: sticky;
    top: var(--topbar-height);
    z-index: 15;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    margin-top: var(--space-4);
    padding: 3px;
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .case-tabs__item {
    min-height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 650;
    cursor: pointer;
  }

  .case-tabs__item.is-active {
    background: var(--color-surface);
    color: var(--color-forest-deep);
    box-shadow: 0 1px 2px rgb(16 54 44 / 10%);
  }

  .case-page [data-case-panel] {
    display: none;
  }

  .case-page[data-active-panel="decisions"] [data-case-panel="decisions"],
  .case-page[data-active-panel="evidence"] [data-case-panel="evidence"] {
    display: block;
  }

  .case-prompt-cta {
    position: fixed;
    right: var(--page-pad);
    bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 0.65rem);
    left: var(--page-pad);
    z-index: 45;
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 0;
    border-radius: 999px;
    background: var(--color-forest);
    color: white;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 20px rgb(16 54 44 / 22%);
  }

  .case-prompt-cta__count {
    display: grid;
    min-width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border-radius: 999px;
    background: rgb(255 255 255 / 22%);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(16 34 27 / 40%);
  }

  .sheet-backdrop[hidden] {
    display: none;
  }

  .prompt-archive.is-sheet {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 80;
    max-height: 86dvh;
    margin: 0;
    overflow: auto;
    border: 0;
    border-radius: 1.25rem 1.25rem 0 0;
    background: var(--color-surface);
    box-shadow: 0 -12px 40px rgb(16 34 27 / 22%);
    overscroll-behavior: contain;
  }

  .prompt-archive.is-sheet::before {
    display: block;
    width: 2.5rem;
    height: 0.25rem;
    margin: 0.55rem auto 0;
    border-radius: 999px;
    background: var(--color-line-strong);
    content: "";
  }

  .prompt-archive.is-sheet > summary {
    display: none;
  }

  .prompt-archive.is-sheet .prompt-archive__close {
    display: inline-flex;
  }

  .prompt-archive.is-sheet .prompt-archive__body {
    padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
  }

  body.prompt-open {
    overflow: hidden;
  }

  @media (min-width: 40rem) {
    .case-section__heading {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .challenge-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .source-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .fingerprint-source dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .fingerprint-source__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .case-page {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      column-gap: var(--space-6);
      align-items: start;
      padding-top: var(--space-5);
    }

    .case-page > :global(.case-hero) {
      display: contents;
    }

    .case-page > :global(.case-hero) > :global([data-hero-item]) {
      grid-column: 2;
      margin-bottom: var(--space-3);
    }

    .case-page > :global(.case-hero) > :global(.case-cover) {
      position: sticky;
      top: calc(var(--topbar-height) + var(--space-4));
      grid-row: 1 / span 40;
      grid-column: 1;
      align-self: start;
    }

    .case-page > .case-section,
    .case-page > .prompt-archive {
      grid-column: 2;
    }

    .case-page [data-case-panel] {
      display: block;
    }

    .case-tabs,
    .case-prompt-cta,
    .sheet-backdrop {
      display: none !important;
    }

    .case-section {
      margin-top: var(--space-6);
      padding-top: var(--space-5);
