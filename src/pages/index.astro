---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/ui/CategoryCard.astro";
import DiscoverySearch from "../components/discovery/DiscoverySearch.astro";
import { getDiscoveryData } from "../components/discovery/discovery-data.js";
import { PENGUIN_QUERY } from "../components/discovery/discovery-types.js";

const data = await getDiscoveryData();
const totalCases = Object.keys(data.cards).length;
const allCards = Object.values(data.cards).sort((left, right) =>
  left.caseId.localeCompare(right.caseId, "en", { numeric: true })
);
const groups = data.categories.map((category) => ({
  category,
  total: data.categoryCounts[category.category_id],
  cards: allCards.filter((card) => card.categoryId === category.category_id).slice(0, 4)
}));
---

<BaseLayout
  title="Agnes Bench"
  description="输入画面任务或选择五类用途，查看结构相近的案例、命中原因、共性难点和一条迁移写法。"
>
  <div class="home" data-home-sections>
    <section class="home-intro" aria-labelledby="home-title">
      <p class="home-intro__eyebrow">AGNES BENCH · {totalCases} 个案例</p>
      <h1 id="home-title">把画面任务，直接对到结构</h1>
      <p class="home-intro__lead">
        说出要做什么，不必先记住专业分类。候选卡会把结构依据、容易漏掉的地方和一条可迁移写法放在一起。
      </p>
    </section>

    <ol class="home-steps" aria-label="三步打开案例">
      <li data-step="1">
        <span>01</span>
        <strong>说任务</strong>
        <p>输入画面目标，或点一张分类卡</p>
      </li>
      <li data-step="2">
        <span>02</span>
        <strong>看匹配</strong>
        <p>核对命中原因和共性难点</p>
      </li>
      <li data-step="3">
        <span>03</span>
        <strong>打开案例</strong>
        <p>查看适合边界、决策和写法</p>
      </li>
    </ol>

    <DiscoverySearch
      instanceId="home-discovery"
      mode="search"
      initialQuery={PENGUIN_QUERY}
      initialCards={data.penguinCards}
      cards={data.cards}
    />

    <div class="home-mode" data-home-mode-panel="featured">
      <section class="discovery-category-section" aria-labelledby="discovery-category-title">
        <div class="discovery-section-heading">
          <div>
            <p class="eyebrow">按用途进入</p>
            <h2 id="discovery-category-title">从“我想……”选一类</h2>
          </div>
          <p>分类只负责缩小入口，版式、标注和参考图条件仍可继续筛选。</p>
        </div>
        <div class="category-grid discovery-category-grid">
          {data.categories.map((category) => (
            <CategoryCard category={category} count={data.categoryCounts[category.category_id]} />
          ))}
        </div>
      </section>
    </div>

    <div class="home-mode home-all" data-home-mode-panel="all">
      {groups.map(({ category, total, cards }) => (
        <section class="home-section" aria-labelledby={`home-group-${category.category_id}`}>
          <div class="home-section__heading">
            <div>
              <h2 id={`home-group-${category.category_id}`}>{category.name}</h2>
              <p>{category.plain_explanation}</p>
            </div>
            <a href={`/categories/${category.category_id}/`}>全部 {total} 个 →</a>
          </div>
          <div class="case-tile-grid">
            {cards.map((card) => (
              <a class="case-tile" href={card.href}>
                <img
                  src={card.image.src}
                  srcset={card.image.srcSet}
                  sizes="(min-width: 64rem) 20vw, 46vw"
                  width={card.image.width}
                  height={card.image.height}
                  alt={card.image.alt}
                  loading="lazy"
                  decoding="async"
                />
                <span class="case-tile__body">
                  <h3>{card.title}</h3>
                  <p>{card.challenge}</p>
                  <span class="case-tile__meta">{card.layoutLabel} · #{card.caseId.replace("case-", "")}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-home-sections]");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-home-mode-value]")];
  if (root) {
    const setMode = (mode: string) => {
      root.dataset.homeMode = mode;
      for (const button of buttons) {
        const active = button.dataset.homeModeValue === mode;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      }
    };
    for (const button of buttons) {
      button.addEventListener("click", () => setMode(button.dataset.homeModeValue ?? "featured"));
    }
    setMode("featured");
  }
</script>
