---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCatalog, getPatterns, verdictLabel } from "../lib/casefirst/data.js";
import type { CatalogCase } from "../lib/casefirst/data.js";

const [catalog, patterns] = await Promise.all([getCatalog(), getPatterns()]);
const cases = catalog.cases;
const reviewed = cases.filter((item) => item.verdict !== "UNREVIEWED").length;
const bucketLabels: Record<string, string> = {
  pass: "PASS",
  fail: "FAIL",
  review: "REVIEW",
  unreviewed: "未评审"
};

function gateInfo(item: CatalogCase): { text: string; tone: string } {
  if (item.verdict === "UNREVIEWED") return { text: "未评审", tone: "none" };
  if (item.topGates.length === 0) return { text: "无门槛失败", tone: "none" };
  const text = item.topGates.join(" · ");
  if (item.bucket === "fail") return { text, tone: "fail" };
  if (item.bucket === "review") return { text, tone: "review" };
  return { text, tone: "none" };
}
---

<BaseLayout
  title="Agnes Bench"
  description="案例流：本站生成图、判定与失败门槛；点开案例看提示词全文和开源项目原图对照。"
>
  <div class="stream" data-case-stream-root>
    <header class="stream-hero">
      <p class="stream-hero__eyebrow">AGNES BENCH · {cases.length} 个案例 · 已评审 {reviewed}</p>
      <h1>案例优先</h1>
      <p class="stream-hero__lead">主图是本站生成图，角标是判定，卡片列出失败门槛前两项。</p>
    </header>

    <section class="case-filter" id="case-filter" aria-labelledby="case-filter-title" data-filter-bar>
      <h2 id="case-filter-title" class="visually-hidden">筛选案例</h2>
      <label class="case-filter__field">
        <span>分类</span>
        <select data-filter="category">
          <option value="all">全部分类</option>
          {catalog.categories.map((category) => (
            <option value={category.category_id}>{category.name}</option>
          ))}
        </select>
      </label>
      <label class="case-filter__field">
        <span>判定</span>
        <select data-filter="verdict">
          <option value="all">全部判定</option>
          {Object.entries(bucketLabels).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </label>
      <label class="case-filter__field">
        <span>门槛</span>
        <select data-filter="gate">
          <option value="all">全部门槛</option>
          {patterns.gates.map((gate) => (
            <option value={gate.gate}>{gate.gate}（{gate.n}）</option>
          ))}
        </select>
      </label>
      <p class="case-filter__count" data-filter-count>{cases.length} 个案例</p>
    </section>

    <ol class="case-stream" data-case-list>
      {cases.map((item, index) => (
        <li
          class="case-card"
          data-category={item.categoryId}
          data-verdict={item.bucket}
          data-gates={item.gates.join(" ")}
        >
          <a class="case-card__link" href={item.href}>
            <div class="case-card__media">
              {item.image ? (
                <img
                  src={item.image.src}
                  srcset={item.image.srcSet}
                  sizes="(min-width: 64rem) 22vw, 46vw"
                  width={item.image.width}
                  height={item.image.height}
                  alt={item.image.alt}
                  loading={index < 4 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index < 4 ? "high" : "auto"}
                />
              ) : (
                <div class="case-card__missing">本站未生成</div>
              )}
              <span class:list={["verdict-badge", `verdict-badge--${item.bucket}`]}>
                {verdictLabel(item)}
              </span>
            </div>
            <div class="case-card__body">
              <h3>{item.title}</h3>
              <p class="case-card__meta">{item.categoryName}</p>
              <p class:list={["case-card__gates", `case-card__gates--${gateInfo(item).tone}`]} data-card-gates>{gateInfo(item).text}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <p class="case-stream__empty" data-filter-empty hidden>没有符合筛选条件的案例。</p>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-case-stream-root]");
  if (root) {
    const selects = [...root.querySelectorAll<HTMLSelectElement>("[data-filter]")];
    const cards = [...root.querySelectorAll<HTMLElement>(".case-card")];
    const count = root.querySelector<HTMLElement>("[data-filter-count]");
    const empty = root.querySelector<HTMLElement>("[data-filter-empty]");
    const apply = (): void => {
      const value = (name: string): string =>
        root.querySelector<HTMLSelectElement>(`[data-filter="${name}"]`)?.value ?? "all";
      const category = value("category");
      const verdict = value("verdict");
      const gate = value("gate");
      let visible = 0;
      for (const card of cards) {
        const matches =
          (category === "all" || card.dataset.category === category)
          && (verdict === "all" || card.dataset.verdict === verdict)
          && (gate === "all" || (card.dataset.gates ?? "").split(" ").includes(gate));
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.textContent = `${visible} 个案例`;
      if (empty) empty.hidden = visible !== 0;
    };
    for (const select of selects) select.addEventListener("change", apply);
    apply();
  }
</script>

<style>
  .stream {
    min-width: 0;
    padding-top: 0.75rem;
  }

  .stream-hero {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.5rem;
  }

  .stream-hero__eyebrow {
    margin: 0;
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .stream-hero h1 {
    margin: 0;
    font-size: 1.625rem;
    line-height: 2rem;
    letter-spacing: -0.02em;
  }

  .stream-hero__lead {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .case-filter {
    position: sticky;
    top: var(--topbar-height);
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .case-filter__field {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  .case-filter__field > span {
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .case-filter select {
    width: 100%;
    min-width: 0;
    height: 2rem;
    padding: 0 0.35rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-forest-deep);
    font-size: 0.75rem;
  }

  .case-filter__count {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .case-stream {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin: 0;
    padding: 0.5rem 0 1rem;
    list-style: none;
  }

  .case-card {
    min-width: 0;
  }

  .case-card[hidden] {
    display: none;
  }

  .case-card__link {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface);
    text-decoration: none;
  }

  .case-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .case-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-card__missing {
    display: grid;
    height: 100%;
    place-items: center;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .verdict-badge {
    position: absolute;
    top: 0.375rem;
    left: 0.375rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .verdict-badge--pass {
    background: #2e6539;
  }

  .verdict-badge--fail {
    background: #b23a2a;
  }

  .verdict-badge--review {
    background: #6b7280;
  }

  .verdict-badge--unreviewed {
    background: rgb(255 255 255 / 92%);
    color: var(--color-muted);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .case-card__body {
    display: grid;
    gap: 0.15rem;
    padding: 14px;
  }

  .case-card__body h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .case-card__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .case-card__gates {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.45;
  }

  .case-card__gates--fail {
    color: #b23a2a;
  }

  .case-card__gates--review {
    color: #6b7280;
  }

  .case-stream__empty {
    padding: 1.5rem 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  @media (min-width: 40rem) {
    .case-stream {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .case-filter {
      grid-template-columns: repeat(3, minmax(0, 10rem));
    }
  }

  @media (min-width: 64rem) {
    .stream {
      padding-top: 1.5rem;
    }

    .stream-hero h1 {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }

    .stream-hero__lead {
      font-size: 1rem;
    }

    .case-stream {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .case-filter {
      position: static;
      padding: 0.75rem 0;
    }
  }
</style>
