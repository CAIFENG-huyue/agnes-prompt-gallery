---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gateLabel, getCatalog, getPatterns, verdictLabel } from "../lib/casefirst/data.js";
import type { CatalogCase } from "../lib/casefirst/data.js";

const [catalog, patterns] = await Promise.all([getCatalog(), getPatterns()]);
const cases = catalog.cases;
const reviewed = cases.filter((item) => item.verdict !== "UNREVIEWED").length;
const bucketLabels: Record<string, string> = {
  pass: "通过 PASS",
  fail: "失败 FAIL",
  review: "待复核 REVIEW",
  unreviewed: "未评审"
};

const categoryCounts = new Map<string, number>();
const bucketCounts: Record<string, number> = { pass: 0, fail: 0, review: 0, unreviewed: 0 };
for (const item of cases) {
  categoryCounts.set(item.categoryId, (categoryCounts.get(item.categoryId) ?? 0) + 1);
  bucketCounts[item.bucket] = (bucketCounts[item.bucket] ?? 0) + 1;
}
const gateCounts = new Map(patterns.gates.map((gate) => [gate.gate, gate.n]));

function gateInfo(item: CatalogCase): { text: string; tone: string } {
  if (item.verdict === "UNREVIEWED") return { text: "未评审", tone: "none" };
  if (item.topGates.length === 0) return { text: "无门槛失败", tone: "none" };
  const text = item.topGates.map((gate) => gateLabel(gate)).join(" · ");
  if (item.bucket === "fail") return { text, tone: "fail" };
  if (item.bucket === "review") return { text, tone: "review" };
  return { text, tone: "none" };
}
---

<BaseLayout
  title="Agnes Bench"
  description="案例流：本站生成图、判定与失败门槛；点开案例看提示词全文和开源项目原图对照。"
>
  <div class="stream" data-case-stream-root>
    <header class="stream-hero">
      <p class="stream-hero__eyebrow">AGNES BENCH · {cases.length} 个案例 · 已评审 {reviewed}</p>
      <h1>案例优先</h1>
      <p class="stream-hero__lead">主图是本站生成图，角标是判定，卡片列出失败门槛前两项。</p>
    </header>

    <section class="case-filter" id="case-filter" aria-labelledby="case-filter-title" data-filter-bar>
      <h2 id="case-filter-title" class="visually-hidden">筛选案例</h2>

      <div class="filter-field" data-filter-field="category">
        <span class="filter-field__label" id="filter-category-label">分类</span>
        <button
          type="button"
          class="filter-trigger"
          data-filter-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="filter-category-label filter-category-value"
        >
          <span class="filter-trigger__value" id="filter-category-value" data-filter-label>全部分类</span>
          <svg class="filter-trigger__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div class="filter-menu" data-filter-menu hidden>
          <div class="filter-menu__list" role="listbox" aria-labelledby="filter-category-label">
            <button type="button" class="filter-option" role="option" data-filter-option data-value="all" data-label="全部分类" aria-selected="true">
              <span class="filter-option__text">全部分类</span>
              <span class="filter-option__meta">{cases.length}</span>
            </button>
            {catalog.categories.map((category) => (
              <button
                type="button"
                class="filter-option"
                role="option"
                data-filter-option
                data-value={category.category_id}
                data-label={category.name}
                aria-selected="false"
              >
                <span class="filter-option__text">{category.name}</span>
                <span class="filter-option__meta">{categoryCounts.get(category.category_id) ?? 0}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="filter-field" data-filter-field="verdict">
        <span class="filter-field__label" id="filter-verdict-label">判定</span>
        <button
          type="button"
          class="filter-trigger"
          data-filter-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="filter-verdict-label filter-verdict-value"
        >
          <span class="filter-trigger__value" id="filter-verdict-value" data-filter-label>全部判定</span>
          <svg class="filter-trigger__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div class="filter-menu" data-filter-menu hidden>
          <div class="filter-menu__list" role="listbox" aria-labelledby="filter-verdict-label">
            <button type="button" class="filter-option" role="option" data-filter-option data-value="all" data-label="全部判定" aria-selected="true">
              <span class="filter-option__text">全部判定</span>
              <span class="filter-option__meta">{cases.length}</span>
            </button>
            {Object.entries(bucketLabels).map(([value, label]) => (
              <button
                type="button"
                class="filter-option"
                role="option"
                data-filter-option
                data-value={value}
                data-label={label}
                aria-selected="false"
              >
                <span class="filter-option__text">{label}</span>
                <span class="filter-option__meta">{bucketCounts[value] ?? 0}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="filter-field filter-field--wide" data-filter-field="gate">
        <span class="filter-field__label" id="filter-gate-label">失败门槛</span>
        <button
          type="button"
          class="filter-trigger"
          data-filter-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="filter-gate-label filter-gate-value"
        >
          <span class="filter-trigger__value" id="filter-gate-value" data-filter-label>全部门槛</span>
          <svg class="filter-trigger__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div class="filter-menu" data-filter-menu hidden>
          <div class="filter-menu__list" role="listbox" aria-labelledby="filter-gate-label">
            <button type="button" class="filter-option" role="option" data-filter-option data-value="all" data-label="全部门槛" aria-selected="true">
              <span class="filter-option__text">全部门槛</span>
              <span class="filter-option__meta">{cases.length}</span>
            </button>
            {patterns.gates.map((gate) => (
              <button
                type="button"
                class="filter-option"
                role="option"
                data-filter-option
                data-value={gate.gate}
                data-label={gateLabel(gate.gate)}
                aria-selected="false"
              >
                <span class="filter-option__text">
                  {gateLabel(gate.gate)}
                  <em>{gate.gate}</em>
                </span>
                <span class="filter-option__meta">{gateCounts.get(gate.gate) ?? 0}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <p class="case-filter__count" data-filter-count><strong>{cases.length}</strong> 个案例</p>
    </section>

    <ol class="case-stream" data-case-list>
      {cases.map((item, index) => (
        <li
          class="case-card"
          data-category={item.categoryId}
          data-verdict={item.bucket}
          data-gates={item.gates.join(" ")}
        >
          <a class="case-card__link" href={item.href}>
            <div class="case-card__media">
              {item.image ? (
                <img
                  src={item.image.src}
                  srcset={item.image.srcSet}
                  sizes="(min-width: 64rem) 22vw, 46vw"
                  width={item.image.width}
                  height={item.image.height}
                  alt={item.image.alt}
                  loading={index < 4 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index < 4 ? "high" : "auto"}
                />
              ) : (
                <div class="case-card__missing">本站未生成</div>
              )}
              <span class:list={["verdict-badge", `verdict-badge--${item.bucket}`]}>
                {verdictLabel(item)}
              </span>
            </div>
            <div class="case-card__body">
              <h3>{item.title}</h3>
              <p class="case-card__meta">{item.categoryName}</p>
              <p class:list={["case-card__gates", `case-card__gates--${gateInfo(item).tone}`]} data-card-gates>{gateInfo(item).text}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <p class="case-stream__empty" data-filter-empty hidden>没有符合筛选条件的案例。</p>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-case-stream-root]");
  if (root) {
    type FilterKey = "category" | "verdict" | "gate";
    const state: Record<FilterKey, string> = { category: "all", verdict: "all", gate: "all" };
    const cards = [...root.querySelectorAll<HTMLElement>(".case-card")];
    const count = root.querySelector<HTMLElement>("[data-filter-count]");
    const empty = root.querySelector<HTMLElement>("[data-filter-empty]");

    const apply = (): void => {
      let visible = 0;
      for (const card of cards) {
        const matches =
          (state.category === "all" || card.dataset.category === state.category)
          && (state.verdict === "all" || card.dataset.verdict === state.verdict)
          && (state.gate === "all" || (card.dataset.gates ?? "").split(" ").includes(state.gate));
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.innerHTML = `<strong>${visible}</strong> 个案例`;
      if (empty) empty.hidden = visible !== 0;
    };

    const fields = [...root.querySelectorAll<HTMLElement>("[data-filter-field]")];
    const closeAll = (except?: HTMLElement): void => {
      for (const field of fields) {
        if (field === except) continue;
        if (!field.classList.contains("is-open")) continue;
        field.classList.remove("is-open");
        const menu = field.querySelector<HTMLElement>("[data-filter-menu]");
        const trigger = field.querySelector<HTMLButtonElement>("[data-filter-trigger]");
        if (menu) menu.hidden = true;
        trigger?.setAttribute("aria-expanded", "false");
      }
    };

    for (const field of fields) {
      const key = field.dataset.filterField as FilterKey;
      const trigger = field.querySelector<HTMLButtonElement>("[data-filter-trigger]");
      const menu = field.querySelector<HTMLElement>("[data-filter-menu]");
      const label = field.querySelector<HTMLElement>("[data-filter-label]");
      if (!trigger || !menu || !label) continue;
      const options = [...menu.querySelectorAll<HTMLButtonElement>("[data-filter-option]")];
      let cursor = 0;

      const focusOption = (index: number): void => {
        if (options.length === 0) return;
        cursor = (index + options.length) % options.length;
        options.forEach((option, i) => {
          option.tabIndex = i === cursor ? 0 : -1;
        });
        options[cursor].focus({ preventScroll: true });
      };

      const open = (): void => {
        closeAll(field);
        const selected = options.findIndex((option) => option.dataset.value === state[key]);
        cursor = selected < 0 ? 0 : selected;
        field.classList.add("is-open");
        menu.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        focusOption(cursor);
      };

      const close = (focusTrigger = false): void => {
        field.classList.remove("is-open");
        menu.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
        if (focusTrigger) trigger.focus({ preventScroll: true });
      };

      const choose = (value: string, text: string): void => {
        state[key] = value;
        label.textContent = text;
        trigger.dataset.active = String(value !== "all");
        for (const option of options) {
          option.setAttribute("aria-selected", String(option.dataset.value === value));
        }
        close(true);
        apply();
      };

      trigger.addEventListener("click", () => {
        if (field.classList.contains("is-open")) close();
        else open();
      });

      trigger.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp" || event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open();
        }
      });

      for (const option of options) {
        option.addEventListener("click", () => choose(option.dataset.value ?? "all", option.dataset.label ?? "全部"));
      }

      menu.addEventListener("keydown", (event: KeyboardEvent) => {
        const last = options.length - 1;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          focusOption(cursor + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          focusOption(cursor - 1);
        } else if (event.key === "Home") {
          event.preventDefault();
          focusOption(0);
        } else if (event.key === "End") {
          event.preventDefault();
          focusOption(last);
        } else if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          const option = options[cursor];
          if (option) choose(option.dataset.value ?? "all", option.dataset.label ?? "全部");
        } else if (event.key === "Escape") {
          event.preventDefault();
          close(true);
        } else if (event.key === "Tab") {
          close();
        }
      });
    }

    document.addEventListener("click", (event: MouseEvent) => {
      const target = event.target as Element | null;
      if (!target?.closest("[data-filter-field]")) closeAll();
    });

    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape") closeAll();
    });

    apply();
  }
</script>

<style>
  .stream {
    min-width: 0;
    padding-top: 0.75rem;
  }

  .stream-hero {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.5rem;
  }

  .stream-hero__eyebrow {
    margin: 0;
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .stream-hero h1 {
    margin: 0;
    font-size: 1.625rem;
    line-height: 2rem;
    letter-spacing: -0.02em;
  }

  .stream-hero__lead {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .case-filter {
    position: sticky;
    top: var(--topbar-height);
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .filter-field {
    position: relative;
    display: grid;
    min-width: 0;
    gap: 3px;
  }

  .filter-field--wide {
    grid-column: 1 / -1;
  }

  .filter-field__label {
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .filter-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    width: 100%;
    min-width: 0;
    min-height: 2.5rem;
    padding: 0.25rem 0.55rem 0.25rem 0.65rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 0.8125rem;
    text-align: left;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .filter-trigger:hover {
    border-color: var(--color-forest);
  }

  .filter-trigger:focus-visible {
    outline: none;
    border-color: var(--color-forest);
    box-shadow: 0 0 0 3px rgb(45 90 60 / 14%);
  }

  .filter-trigger[data-active="true"] .filter-trigger__value {
    color: var(--color-forest-deep);
    font-weight: 650;
  }

  .filter-trigger__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .filter-trigger__chevron {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-muted);
    transition: transform 0.18s ease;
  }

  .filter-field.is-open .filter-trigger {
    border-color: var(--color-forest);
    box-shadow: 0 0 0 3px rgb(45 90 60 / 14%);
  }

  .filter-field.is-open .filter-trigger__chevron {
    transform: rotate(180deg);
    color: var(--color-forest-deep);
  }

  .filter-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    z-index: 40;
    min-width: max(100%, 13rem);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface);
    box-shadow: 0 14px 34px rgb(22 34 27 / 14%), 0 2px 6px rgb(22 34 27 / 6%);
    animation: filter-menu-in 0.16s ease;
  }

  @keyframes filter-menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .filter-menu__list {
    display: grid;
    gap: 2px;
    max-height: min(58vh, 18rem);
    padding: 0.35rem;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .filter-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    color: var(--color-ink);
    font-size: 0.8125rem;
    line-height: 1.35;
    text-align: left;
  }

  .filter-option:hover,
  .filter-option:focus-visible {
    background: var(--color-surface-muted);
  }

  .filter-option:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .filter-option[aria-selected="true"] {
    background: var(--color-surface-muted);
    color: var(--color-forest-deep);
    font-weight: 650;
  }

  .filter-option__text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .filter-option__text em {
    display: inline-block;
    margin-left: 0.35rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-style: normal;
    font-weight: 500;
  }

  .filter-option__meta {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .filter-option[aria-selected="true"] .filter-option__meta {
    color: var(--color-forest-deep);
  }

  .case-filter__count {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .case-filter__count strong {
    color: var(--color-forest-deep);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .case-stream {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin: 0;
    padding: 0.5rem 0 1rem;
    list-style: none;
  }

  .case-card {
    min-width: 0;
  }

  .case-card[hidden] {
    display: none;
  }

  .case-card__link {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface);
    text-decoration: none;
  }

  .case-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .case-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-card__missing {
    display: grid;
    height: 100%;
    place-items: center;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .verdict-badge {
    position: absolute;
    top: 0.375rem;
    left: 0.375rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .verdict-badge--pass {
    background: #2e6539;
  }

  .verdict-badge--fail {
    background: #b23a2a;
  }

  .verdict-badge--review {
    background: #6b7280;
  }

  .verdict-badge--unreviewed {
    background: rgb(255 255 255 / 92%);
    color: var(--color-muted);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .case-card__body {
    display: grid;
    gap: 0.15rem;
    padding: 14px;
  }

  .case-card__body h3 {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .case-card__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .case-card__gates {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.45;
  }

  .case-card__gates--fail {
    color: #b23a2a;
  }

  .case-card__gates--review {
    color: #6b7280;
  }

  .case-stream__empty {
    padding: 1.5rem 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  @media (max-width: 40rem) {
    .filter-menu {
      min-width: 100%;
    }
  }

  @media (min-width: 40rem) {
    .case-stream {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .case-filter {
      grid-template-columns: repeat(3, minmax(0, 12rem));
    }

    .filter-field--wide {
      grid-column: auto;
    }
  }

  @media (min-width: 64rem) {
    .stream {
      padding-top: 1.5rem;
    }

    .stream-hero h1 {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }

    .stream-hero__lead {
      font-size: 1rem;
    }

    .case-stream {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .case-filter {
      position: static;
      padding: 0.75rem 0;
    }
  }
</style>
