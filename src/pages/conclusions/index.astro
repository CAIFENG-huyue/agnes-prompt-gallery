---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCatalog, getPatterns, gateLabel } from "../../lib/casefirst/data.js";

const [catalog, patterns] = await Promise.all([getCatalog(), getPatterns()]);
const totalCases = catalog.cases.length;
const judged = patterns.judged;
const pass = (patterns.totals.PASS ?? 0) + (patterns.totals["PASS-WEAK"] ?? 0);
const fail = patterns.totals.FAIL ?? 0;
const review = patterns.totals.REVIEW ?? 0;
const blocked = patterns.totals.BLOCKED ?? 0;
const unreviewed = totalCases - judged;
const passRate = judged > 0 ? ((pass / judged) * 100).toFixed(1) : "0.0";
const gateTotal = patterns.gates.reduce((sum, gate) => sum + gate.n, 0);
const missingImages = catalog.cases.filter((item) => !item.image).length;
---

<BaseLayout
  title="结论"
  description="总盘：已评审数、通过率、各分类差异、门槛分布与局限说明。"
>
  <div class="conclusions">
    <header class="conclusions__head">
      <p class="conclusions__eyebrow">OVERVIEW · content/verdicts.json + content/patterns.json</p>
      <h1>结论</h1>
      <p class="conclusions__meta">{totalCases} 个案例 · 已评审 {judged} · 未评审 {unreviewed}</p>
    </header>

    <section class="metric-grid" aria-label="总盘数字">
      <div class="metric">
        <span>已评审</span>
        <strong>{judged}</strong>
        <small>共 {totalCases} 条</small>
      </div>
      <div class="metric">
        <span>通过率</span>
        <strong>{passRate}%</strong>
        <small>{pass} / {judged}（含 PASS-WEAK）</small>
      </div>
      <div class="metric">
        <span>FAIL</span>
        <strong>{fail}</strong>
        <small>REVIEW {review} · BLOCKED {blocked}</small>
      </div>
      <div class="metric">
        <span>未评审</span>
        <strong>{unreviewed}</strong>
        <small>缺图 {missingImages}</small>
      </div>
    </section>

    <section class="conclusions__section" aria-labelledby="category-diff-title">
      <div class="conclusions__section-head">
        <h2 id="category-diff-title">各分类差异</h2>
        <span>分类 × 通过率，n 为本分类已评审数</span>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">分类</th>
              <th scope="col">通过 / n</th>
              <th scope="col">通过率</th>
              <th scope="col">FAIL</th>
              <th scope="col">REVIEW</th>
            </tr>
          </thead>
          <tbody>
            {patterns.categories.map((row) => (
              <tr>
                <th scope="row">
                  <span class="data-table__name">{catalog.categoryNames.get(row.category) ?? row.category}</span>
                  <code>{row.category}</code>
                </th>
                <td>{row.pass} / {row.n}</td>
                <td><strong>{row.pass_rate.toFixed(1)}%</strong></td>
                <td>{row.fail}</td>
                <td>{row.review}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="conclusions__section" aria-labelledby="gate-dist-title">
      <div class="conclusions__section-head">
        <h2 id="gate-dist-title">门槛分布</h2>
        <span>{patterns.gates.length} 个门槛 · 命中 {gateTotal} 次（同一案例可多计）</span>
      </div>
      <ol class="gate-bars">
        {patterns.gates.map((gate) => (
          <li>
            <div class="gate-bars__top">
              <span>{gateLabel(gate.gate)} <code>{gate.gate}</code></span>
              <strong>{gate.n}</strong>
            </div>
            <div class="gate-bars__track">
              <span style={`width: ${((gate.n / patterns.gates[0].n) * 100).toFixed(1)}%`}></span>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="conclusions__section" aria-labelledby="limits-title">
      <div class="conclusions__section-head">
        <h2 id="limits-title">局限说明</h2>
      </div>
      <ul class="limits">
        <li>未评审 {unreviewed} 条：没有判定记录，角标显示「未评审」。</li>
        <li>REVIEW {review} 条：判定通道未给出 PASS/FAIL 结论。</li>
        <li>判定模型：agnes-image-2.5-flash；生成图按同题提示词产出，质量参差，包含失败样本。</li>
        <li>缺图 {missingImages} 条：本站没有对应生成图，案例页标注「本站未生成」。</li>
        <li>原图来源：freestylefly/awesome-gpt-image-2（小红书号 insight_express 整理）。</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .conclusions {
    display: grid;
    gap: 1rem;
    padding-top: 0.75rem;
  }

  .conclusions__eyebrow {
    margin: 0;
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
  }

  .conclusions h1 {
    margin: 0.15rem 0 0;
    font-size: 1.625rem;
    line-height: 2rem;
  }

  .conclusions__meta {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .metric {
    display: grid;
    gap: 0.1rem;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface);
  }

  .metric > span {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }

  .metric strong {
    color: var(--color-forest-deep);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .metric small {
    color: var(--color-muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }

  .conclusions__section {
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface);
  }

  .conclusions__section-head {
    display: grid;
    gap: 0.15rem;
    margin-bottom: 0.5rem;
  }

  .conclusions__section-head h2 {
    margin: 0;
    font-size: 0.9375rem;
  }

  .conclusions__section-head span {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
  }

  .data-table th,
  .data-table td {
    padding: 0.5rem 0.375rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .data-table thead th {
    color: var(--color-muted);
    font-size: 0.625rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .data-table tbody th {
    font-weight: 500;
  }

  .data-table__name {
    display: block;
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .data-table code {
    display: block;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
  }

  .data-table strong {
    color: var(--color-forest-deep);
    font-family: var(--font-mono);
  }

  .gate-bars {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gate-bars__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .gate-bars__top code {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
  }

  .gate-bars__top strong {
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
  }

  .gate-bars__track {
    height: 0.35rem;
    margin-top: 0.2rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .gate-bars__track span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .limits {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (min-width: 40rem) {
    .metric-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .conclusions {
      gap: 1.5rem;
      padding-top: 1.5rem;
    }

    .conclusions h1 {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }

    .conclusions__section {
      padding: 1rem;
    }

    .data-table {
      font-size: 0.8125rem;
    }
  }
</style>
